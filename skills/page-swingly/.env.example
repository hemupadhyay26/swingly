OPENAI_API_KEY=sk-...

# Which model/quality to generate with. gpt-image-1-mini + low is the
# cheapest combo, meant for testing the pipeline rather than final quality.
# Switch to gpt-image-2 + medium/high once you're generating real output.
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_IMAGE_QUALITY=low

# api keeps the existing API-key flow; codex prints a prompt then imports a PNG.
# Codex subscription generation happens in signed-in Codex, not this Python SDK.
PAGE_SWINGLY_PROVIDER=api
